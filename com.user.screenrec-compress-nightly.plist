<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <key>Label</key>
  <string>com.user.screenrec-compress-nightly</string>

  <!-- Off-hours only: fire once nightly at 3:00am and stop starting new    -->
  <!-- files at 7:00am (--until). compress.sh drains the queue (looping     -->
  <!-- until no new files are found or the deadline is hit), so a single    -->
  <!-- nightly trigger picks up everything that arrived since the last run. -->
  <!-- The file already encoding when 7am hits is NOT interrupted -- only   -->
  <!-- the next file in the queue is held back. Adjust Hour/Minute below    -->
  <!-- and the --until value together if you want a different window.      -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <!-- EDIT: set this to the absolute path of compress.sh on this machine. -->
    <string>/Users/YOUR_USERNAME/Projects/screenrec-compress/compress.sh</string>
    <string>--until</string>
    <string>07:00</string>
    <!-- EDIT: set this to the absolute path of your Screen Recordings folder. -->
    <string>/Volumes/YOUR_DRIVE/Screen Recordings</string>
  </array>

  <!-- launchd runs agents in a minimal environment with no PATH.         -->
  <!-- We set it explicitly so ffmpeg (Homebrew) and bash can be found.  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <!-- EDIT: set this to wherever you want the log to live. -->
  <string>/Users/YOUR_USERNAME/Library/Logs/screenrec-compress-nightly.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/screenrec-compress-nightly.log</string>

  <!-- Do not run immediately on load — only fire at the scheduled time. -->
  <key>RunAtLoad</key>
  <false/>

</dict>
</plist>
